{
	"name": "medsoft",
	"private": true,
	"version": "1.0.26",
	"type": "module",
	"main": "dist-electron/main.js",
	"description": "Software for medical appointments.",
	"author": {
		"name": "Amir Benhadid",
		"email": "amir.benhadid@outlook.com",
		"url": "https://github.com/Amir-Benhadid"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/Amir-Benhadid/MedSoft"
	},
	"scripts": {
		"launch": "npm run build && npm run dev",
		"dev": "npm run clean && npm run dev:start",
		"dev:start": "concurrently \"npm run dev:ui\" \"npm run electron\"",
		"dev:ui": "vite --config vite.config.ui.js",
		"frontend": "vite --port 3000",
		"electron": "wait-on http://127.0.0.1:3001 && cross-env NODE_ENV=development PORT=3001 concurrently \"npm run build:electron:watch\" \"electronmon .\"",
		"build:electron": "tsc --project src/electron/tsconfig.json",
		"build:electron:watch": "tsc --project src/electron/tsconfig.json --watch --preserveWatchOutput",
		"build": "npm run build:electron && vite build",
		"build:ui": "vite build --config vite.config.ui.js",
		"build:win": "npm run build && electron-builder --win",
		"build:win-portable": "npm run build && electron-builder --win portable",
		"build:win-installer": "npm run build && electron-builder --win nsis",
		"dist": "npm run build && electron-builder",
		"dist:win": "npm run build && electron-builder --publish=never --win",
		"release": "tsx scripts/release.ts",
		"clean": "node -e \"console.log('🧹 Starting fresh...'); process.exit(0)\"",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:ui": "vitest --ui",
		"test:coverage": "vitest run --coverage",
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui",
		"test:e2e:report": "playwright show-report",
		"medicines:setup": "node scripts/setup-medicines.js",
		"medicines:seed": "node scripts/seed-medicines.js",
		"db:clear": "tsx scripts/clear-db.ts",
		"health": "echo 'Server removed – no health endpoint'",
		"ui:add": "npx shadcn@latest add",
		"reset": "tsx scripts/reset-app.ts"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"better-sqlite3",
			"core-js",
			"electron",
			"esbuild",
			"supabase"
		],
		"patchedDependencies": {
			"electronmon": "patches/electronmon.patch"
		}
	},
